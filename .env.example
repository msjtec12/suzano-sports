# ============================================================================
# SUZANO SPORTS — VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e configure as credenciais de produção
# ============================================================================

# 1. BANCO DE DADOS NEON POSTGRESQL (Obrigatório em Produção / Vercel)
# Formato: postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
# Em desenvolvimento local, caso omitido, utiliza PostgreSQL 16 embarcado persistente (.data/pglite)
DATABASE_URL=""

# 2. SEGURANÇA E SESSÃO (Obrigatório em Produção)
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-esta-chave-secreta-em-producao-minimo-32-bytes"

# 3. CREDENCIAIS INICIAIS DO ADMINISTRADOR (Usadas apenas no primeiro seed)
INITIAL_ADMIN_EMAIL="admin@suzanosports.com.br"
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Administrador Suzano Sports"

# 4. WHATSAPP OFICIAL DA LOJA (Apenas números com DDI 55 + DDD 11 + Número)
# Também pode ser configurado e validado diretamente em /admin/configuracoes
NEXT_PUBLIC_STORE_WHATSAPP=""

# 5. OBJECT STORAGE PARA IMAGENS DE PRODUTOS (Opcional — Vercel Blob / S3 Compatível)
BLOB_READ_WRITE_TOKEN=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# 6. SEO, ANALYTICS E DOMÍNIO PÚBLICO
NEXT_PUBLIC_SITE_URL="https://suzanosports.com.br"
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
